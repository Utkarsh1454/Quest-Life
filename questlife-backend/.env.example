PROJECT_NAME=Quest Life
DEBUG=true

# Database Connection:
# Default local development uses SQLite async driver:
DATABASE_URL=sqlite+aiosqlite:///./questlife.db
# For production PostgreSQL deployments, uncomment and configure:
# DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/questlife

# Security & Authentication (Generate a strong 32+ byte random secret for production):
SECRET_KEY=generate_a_secure_random_secret_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Integrations:
WORKOUTXAPP_API_KEY=your_workoutxapp_api_key_here

# CORS Allowed Origins (Comma-separated list):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Clerk Authentication (Copy Secret Key from https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY_HERE
CLERK_ISSUER=https://your-app.clerk.accounts.dev

